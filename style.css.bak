:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #87c8ff; }
canvas { display: block; }
#hud { position: fixed; top: 18px; left: 18px; z-index: 10; padding: 14px 16px; background: rgba(4,12,28,.68); border: 1px solid rgba(255,255,255,.16); border-radius: 12px; backdrop-filter: blur(8px); box-shadow: 0 12px 30px rgba(0,0,0,.2); line-height: 1.45; min-width: 310px; }
#hud .title { font-weight: 900; letter-spacing: .18em; font-size: 14px; margin-bottom: 5px; color: #fff; }
#mission, #speed, #mode { font-size: 13px; color: #eaf4ff; }
#crosshair { position: fixed; z-index: 8; left: 50%; top: 50%; transform: translate(-50%,-50%); font: 700 25px/1 monospace; color: rgba(255,255,255,.75); text-shadow: 0 1px 4px #000; pointer-events: none; }
.panel { position: fixed; z-index: 20; width: min(520px, calc(100vw - 32px)); left: 50%; top: 50%; transform: translate(-50%,-50%); padding: 26px; background: rgba(6,13,31,.94); border: 1px solid rgba(255,255,255,.18); border-radius: 18px; box-shadow: 0 24px 80px rgba(0,0,0,.45); text-align: center; }
.panel.hidden { display: none; }
.panel h1 { margin: 0 0 8px; letter-spacing: .08em; }
.panel p { margin: 0 0 18px; color: #c9d8ee; }
.keys { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; text-align: left; margin: 18px 0 22px; }
kbd { display: inline-block; min-width: 56px; padding: 4px 7px; margin-right: 6px; border-radius: 6px; background: #202a42; border: 1px solid #44516e; box-shadow: inset 0 -2px 0 rgba(0,0,0,.35); color: #fff; font: 700 11px/1.2 monospace; text-align:center; }
button { cursor: pointer; border: 0; border-radius: 10px; padding: 13px 24px; font-weight: 900; letter-spacing: .08em; background: #f4f7ff; color: #10172a; }
button:hover { transform: translateY(-1px); }
small { display:block; margin-top: 12px; color:#8290ac; }
#message { position: fixed; z-index: 11; left: 50%; top: 18%; transform: translateX(-50%); color: white; font-size: clamp(18px, 2.5vw, 34px); font-weight: 900; text-shadow: 0 3px 10px rgba(0,0,0,.55); opacity: 0; transition: opacity .25s; pointer-events: none; }
#message.show { opacity: 1; }
@media (max-width: 650px) { .keys { grid-template-columns:1fr; } #hud { min-width: auto; right:18px; } }

#boss-hud { position: fixed; z-index: 10; left: 50%; top: 18px; transform: translateX(-50%); width: min(520px, calc(100vw - 380px)); min-width: 300px; padding: 10px 14px; background: rgba(24,4,7,.78); border: 1px solid rgba(255,120,120,.32); border-radius: 12px; backdrop-filter: blur(8px); box-shadow: 0 12px 30px rgba(0,0,0,.22); }
.boss-title { display:flex; justify-content:space-between; gap:16px; font-size:12px; font-weight:900; letter-spacing:.14em; color:#ffe8e8; margin-bottom:7px; }
.bar { height:9px; overflow:hidden; border-radius:999px; background:rgba(255,255,255,.12); }
#boss-health-fill { height:100%; width:100%; background:linear-gradient(90deg,#7a0914,#ff334d); transition:width .18s ease; }
#player-health { font-size:13px; color:#eaf4ff; }
@media (max-width: 900px) { #boss-hud { top: auto; bottom: 18px; width: calc(100vw - 36px); min-width: 0; } }

.configurator-link {
  display: block;
  margin: 12px 0 8px;
  padding: 10px 14px;
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 8px;
  color: #fff;
  background: rgba(17,28,45,.72);
  text-decoration: none;
  text-align: center;
  font-weight: 700;
  letter-spacing: .04em;
}
.configurator-link:hover { background: rgba(36,74,126,.85); }
